# --- Contact form (Resend) ---------------------------------------------------
# Get a free API key at https://resend.com (3,000 emails/mo free).
RESEND_API_KEY=

# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL=hello@mykt.studio

# The "from" address. The domain must be verified in Resend.
# For local testing before verifying your domain, use:
#   CONTACT_FROM_EMAIL="MYKTECH <onboarding@resend.dev>"
CONTACT_FROM_EMAIL="MYKTECH <hello@mykt.studio>"

# Real secrets go in .env.local (gitignored). On Vercel, set these in
# Project → Settings → Environment Variables.
