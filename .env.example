# ⚠️  TEMPLATE ONLY — this file is committed to git. DO NOT put real secrets here.
# Copy it to .env.local (gitignored) for local dev, and set the same keys in
# Vercel → Settings → Environment Variables for production.

# --- Contact form (Resend) ---------------------------------------------------
# Get a free API key at https://resend.com (3,000 emails/mo free).
RESEND_API_KEY=

# Where contact-form submissions are delivered (your real inbox).
CONTACT_TO_EMAIL=you@example.com

# The "from" address. Use the resend.dev sandbox until your own domain is
# verified in Resend (an unverified domain like hello@mykt.studio will be rejected).
CONTACT_FROM_EMAIL="MYKTECH <onboarding@resend.dev>"
