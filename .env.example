# ⚠️  TEMPLATE ONLY — this file is committed to git. DO NOT put real secrets here.
# Copy it to .env.local (gitignored) for local dev, and set the same keys in
# Vercel → Settings → Environment Variables for production.

# --- Site assistant / chatbot (Google Gemini) --------------------------------
# Get a key at https://aistudio.google.com/apikey (free tier available).
#
# Server-only — do NOT prefix with NEXT_PUBLIC_. The chat runs through the route
# handler at app/api/chat/route.ts so the key never reaches the browser.
#
# Leave BLANK and the site still builds and runs: /api/chat returns 503 and the
# widget shows "Chat isn't configured yet. Please use the contact form."
GEMINI_API_KEY=

# Which model answers (server-only, read in lib/chat-config.ts). Leave BLANK for
# the default, gemini-3.6-flash — the model docs name that exact id as the
# STABLE choice for production apps.
# ⚠️ Don't put a "-preview" (or "-exp") id here in production: previews get
# tighter rate limits and can be shut down with ~2 weeks' notice. One is
# accepted but logged; an id that doesn't look like a model id falls back to the
# default. Changing it doesn't touch the (byte-stable, prompt-cached) system
# prompt.
GEMINI_MODEL=

# --- Contact form (Resend) ---------------------------------------------------
# Get a free API key at https://resend.com (3,000 emails/mo free).
RESEND_API_KEY=

# Where contact-form submissions are delivered (your real inbox).
CONTACT_TO_EMAIL=you@example.com

# The "from" address. Use the resend.dev sandbox until your own domain is
# verified in Resend (an unverified domain like hello@mykt.studio will be rejected).
#
# Use DOUBLE quotes here, not single. The apostrophe in "R Ally's Tech" would
# terminate a single-quoted dotenv value early and truncate the name to "R Ally".
# No inner quoting is needed any more: the old mykTech() required it because
# "()" are RFC 5322 comment delimiters, but an apostrophe is valid atext.
CONTACT_FROM_EMAIL="R Ally's Tech <onboarding@resend.dev>"

# --- Admin panel / CMS (Supabase) --------------------------------------------
# All optional: with these blank the public site serves its static content and
# /admin shows setup steps. Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. SERVER-ONLY — never prefix with NEXT_PUBLIC_, never commit.
# Required to invite, resend, revoke and remove teammates (and to send
# password-reset links), because only the service role can create auth users.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin panel emails: team invites + password resets (Resend) -------------
# Uses the same RESEND_API_KEY as the contact form above. Without it, invites
# still work: the Team page hands you the link to copy and send by chat.
#
# Sender for panel emails. Falls back to CONTACT_FROM_EMAIL, then to Resend's
# sandbox sender. ⚠️ While sending from onboarding@resend.dev, Resend ONLY
# delivers to your own Resend account's address — everyone else's invite comes
# back as a "copy this link" fallback. To email the whole team:
#   1. resend.com/domains → Add domain → add the DNS records it shows → Verify
#   2. set this to an address on that domain, e.g.
#        ADMIN_FROM_EMAIL="R Ally's Tech <team@your-domain.com>"
# DOUBLE quotes, as with CONTACT_FROM_EMAIL (the apostrophe ends a '…' value).
ADMIN_FROM_EMAIL=

# Invite links last 7 days and reset links 1 hour. They're our own tokens
# (only a sha256 is stored, in auth_tokens), so Supabase's "Email OTP
# Expiration" no longer applies and there's nothing to set here. The old
# AUTH_LINK_EXPIRY_HOURS is gone — the TTLs live in app/admin/auth/_lib/tokens.ts.

# --- Security: IP hashing + rate limits --------------------------------------
# Server-only — do NOT prefix with NEXT_PUBLIC_.
#
# Key for hashing visitor IPs (lib/security.ts). Raw IPs are never stored: the
# inbox keeps an HMAC of the address, and the rate limiter is keyed the same
# way. Generate one (64 hex chars):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Its OWN secret — don't reuse the service-role key or any other secret here.
# Set it once and leave it: changing it re-keys every hash, so existing chat
# snapshots stop threading together and every rate-limit window resets.
# Leave BLANK and everything still works, but on a built-in fallback key that
# is public in the source, so the stored hashes are not private (production
# logs a warning).
#
# The limits themselves are durable — counted in Supabase via the
# consume_security_limit function in supabase/schema.sql, which uses
# SUPABASE_SERVICE_ROLE_KEY above. Without Supabase (or while it's paused) the
# contact form and chat fall back to a per-instance in-memory limit; the admin
# auth endpoints fail closed instead, since an unmetered login is worse than a
# briefly unavailable one.
IP_HASH_SECRET=

# The one address that is ALWAYS the panel owner. Nothing in the database can
# demote or lock it out — it's the recovery path if roles get mangled.
# Server-only; use the address you sign in to /admin with.
OWNER_EMAIL=

# --- Status page: CI ingest (GitHub Actions → /api/status/ingest) ------------
# Server-only — do NOT prefix with NEXT_PUBLIC_.
#
# Bearer token .github/workflows/status.yml sends when it posts test runs and
# Lighthouse scores for the public /status page. Generate a fresh one (64 hex):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# and put the SAME value in GitHub → Settings → Secrets and variables →
# Actions → secret STATUS_INGEST_TOKEN (plus a variable SITE_URL = the
# production origin).
#
# Its OWN secret — never the service-role key, IP_HASH_SECRET or any session
# secret, and don't derive it from one. A GitHub secret is the easiest kind to
# leak (a workflow log, a fork, a compromised action); if this one leaks, all
# it can do is post a status report (30/hour). Rotate it in both places at once.
# Blank or shorter than 32 characters → the endpoint answers 503 and /status
# simply shows its last report (or its empty state).
STATUS_INGEST_TOKEN=
